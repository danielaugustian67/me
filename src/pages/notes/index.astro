---
import Base from '../../layouts/Base.astro';
import { notes } from '../../data/site';

// Repeated so the looping grid always fills the screen.
const loop = [...notes, ...notes, ...notes];
---

<Base title="Notes" footer={false} lenis={false}>
  <h1 class="sr-only">Notes</h1>
  <div class="pan" data-pan="notes">
    {
      loop.map((n, i) => (
        <a class="pan__note card" href={`/notes/${n.slug}`} draggable="false" {...(i >= notes.length ? { 'aria-hidden': 'true', tabindex: -1 } : {})}>
          <span class="card__img"><img src={n.image} alt="" decoding="async" draggable="false" style="pointer-events:none" /></span>
          <time class="card__date">{n.date}</time>
          <h2 class="card__title h-sm">{n.title}</h2>
          <p class="card__text">{n.excerpt}</p>
        </a>
      ))
    }
  </div>
</Base>
