---
import Pill from '../components/Pill.astro';
import TalkForm from '../components/TalkForm.astro';
import TextLink from '../components/TextLink.astro';
import Base from '../layouts/Base.astro';
import { home, site, wideSrcset } from '../data/site';

const letters = 'ABCDEFGH';

// Each digit column rolls through filler digits, stopping on one stat at a time.
const FILLER = 3;
const places = home.stats[0].value.length;
const digitCols = Array.from({ length: places }, (_, place) => {
  const cells: { d: string; image: string }[] = [];
  home.stats.forEach((stat) => {
    for (let f = 0; f < FILLER; f++) {
      cells.push({ d: String((Number(stat.value[place]) + 7 + f * 3) % 10), image: stat.image });
    }
    cells.push({ d: stat.value[place], image: stat.image });
  });
  return cells;
});

// On phones each stat sits above its own text and rolls on its own.
const soloCols = (value: string) =>
  [...value].map((d) => [...Array.from({ length: FILLER }, (_, f) => String((Number(d) + 7 + f * 3) % 10)), d]);

---

<Base>
  <section class="hero">
    <p class="hero__intro">{site.intro}</p>
    <div class="hero__stack">
      {home.heroImages.map((src) => <img class="hero__img" src={src} alt="" decoding="async" />)}
      <a class="hero__link" href="/work" aria-label="See the work" data-cursor="arrow"></a>
    </div>
    <h1 class="hero__title h-xxl" data-fit="0.8"><span class="hero__word">{site.brand}<span class="mark">{site.mark}</span></span></h1>
  </section>

  <section class="scatter" data-scatter>
    <div class="scatter__stage">
      <h2 class="scatter__text">{home.statement}</h2>
    </div>
  </section>

  <section class="approach">
    {home.approach.map((p) => <p class="body" data-fade>{p}</p>)}
  </section>

  <section class="reel" aria-label="Showreel">
    <div class="reel__sticky" aria-hidden="true">
      <div class="marquee" data-marquee="1"><span>{home.reelText}</span></div>
      <div class="marquee marquee--ghost" data-marquee="-1"><span>{home.reelText}</span></div>
    </div>
    <div class="reel__frames">
      {home.reel.map((r) => <a class="reel__frame" href={r.href} data-parallax data-cursor="arrow"><img src={r.src} srcset={wideSrcset(r.src)} sizes="(max-width: 809px) 84vw, 62vw" alt={r.alt} loading="lazy" decoding="async" /></a>)}
    </div>
  </section>

  <section class="split">
    <aside class="split__aside">
      <h2 class="h-sm">{home.servicesTitle}</h2>
      <div>
        <p class="note">{home.servicesNote}</p>
        <div style="margin-top:24px"><TextLink href="/contact" label="Get Started" /></div>
      </div>
    </aside>
    <div>
      {
        home.services.map((service, i) => (
          <article class="services__item">
            <p class="services__letter ghost">{letters[i]} /</p>
            <div>
              <h3 class="h-md" data-words>{service.text}</h3>
              <ul class="services__tags" data-stagger>{service.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="numbers__head">
    <div class="name-box"><h2 class="h-lg name-fit" style={`--chars:${site.brand.length}`} data-words>{site.brand}{site.mark}<br />In Numbers</h2></div>
    <div>
      <p class="note">{home.numbersNote}</p>
      <TextLink href="/contact" label="Let’s work together" />
    </div>
  </section>

  <section class="numbers" data-numbers>
    <div class="numbers__stage" aria-hidden="true">
      <div class="digits">
        {
          digitCols.map((cells) => (
            <div class="digits__col" data-count={cells.length}>
              <span class="digits__roll">
                {cells.map((c) => <span class="digits__n" style={`background-image:url(${c.image})`}>{c.d}</span>)}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="numbers__panels">
      {
        home.stats.map((stat) => (
          <article class="numbers__panel">
            <div class="digits digits--solo" aria-hidden="true">
              {
                soloCols(stat.value).map((cells) => (
                  <div class="digits__col" data-count={cells.length}>
                    <span class="digits__roll">
                      {cells.map((d) => <span class="digits__n" style={`background-image:url(${stat.image})`}>{d}</span>)}
                    </span>
                  </div>
                ))
              }
            </div>
            <span class="numbers__logo"><img src={stat.logo.src} alt={stat.logo.alt} loading="lazy" /></span>
            <h3 class="h-md pre">{`${Number(stat.value)} ${stat.title}`}</h3>
            <p class="body">{stat.text}</p>
            <Pill href={stat.cta.href} label={stat.cta.label} />
          </article>
        ))
      }
    </div>
  </section>

  <section class="split split--mid">
    <aside class="split__aside">
      <span></span>
      <div><Pill href="/about" label="More About Me" /></div>
    </aside>
    <div class="aboutme__body">
      <h2 class="h-lg" data-words>{home.aboutTitle}</h2>
      <p class="body aboutme__text" data-fade>{home.aboutText}</p>
    </div>
  </section>

  <section class="process">
    <div class="process__head">
      <h2 class="h-lg" data-words>{home.processTitle}</h2>
      <p class="note" data-fade>{home.processNote}</p>
    </div>
    <div class="gantt" style={`--weeks:${home.processWeeks}`} aria-hidden="true">
      <div class="gantt__lines">
        {Array.from({ length: home.processWeeks }, (_, i) => <div><span>{String(i + 1).padStart(2, '0')}</span></div>)}
      </div>
      {
        home.process.map((p) => (
          <div class="gantt__row">
            <div class="gantt__bar" style={`--from:${p.from};--to:${p.to}`}>{p.title}</div>
          </div>
        ))
      }
    </div>
    <ol class="process__steps" data-stagger>
      {
        home.process.map((p, i) => (
          <li>
            <b>{String(i + 1).padStart(2, '0')}</b>
            <h3 class="h-sm" style="font-weight:700">{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <div class="section-title wrap">
      <h2 class="h-xl" data-words>{home.quotesTitle}</h2>
    </div>
    <div class="quotes__body">
      <blockquote class="quote__text">“{home.quote}”</blockquote>
    </div>
  </section>

  <section class="split split--narrow">
    <aside class="split__aside">
      <span></span>
      <div>
        <p class="note">{home.contactNote}</p>
        <div style="margin-top:24px"><TextLink href="/about" label="About Me" /></div>
      </div>
    </aside>
    <TalkForm />
  </section>
</Base>
