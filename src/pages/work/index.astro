---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';

// Three projects are too few to fill the wrapping gallery, so they repeat. Repeats are hidden from assistive tech.
const tiles = Array.from({ length: 12 }, (_, i) => ({
  project: projects[i % projects.length],
  landscape: i % 2 === 1,
  repeat: i >= projects.length,
}));
---

<Base title="Work" footer={false} lenis={false}>
  <div class="pan" data-pan="work">
    <div class="pan__title">
      <div>
        <h1 class="h-xl" style="font-size:clamp(90px,16.67vw,240px)">Work</h1>
        <p class="pan__hint">scroll / drag</p>
      </div>
    </div>
    {
      tiles.map(({ project: p, landscape, repeat }) => (
        <a class="pan__item" data-cursor="arrow" href={`/work/${p.slug}`} data-landscape={String(landscape)} aria-label={p.name} aria-hidden={repeat ? 'true' : undefined} tabindex={repeat ? -1 : undefined}>
          <img src={landscape ? p.wide : p.tall} alt="" decoding="async" draggable="false" />
          <span class="pan__label">{p.name}</span>
        </a>
      ))
    }
  </div>
</Base>
