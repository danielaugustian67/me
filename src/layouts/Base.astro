---
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import Chrome from '../components/Chrome.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const { title, description, footer = true, lenis = true } = Astro.props as {
  title?: string;
  description?: string;
  footer?: boolean;
  lenis?: boolean;
};
const pageTitle = title ? `${title} — ${site.brand}` : site.title;
const pageDescription = description ?? site.description;
---

<!doctype html>
<html lang="en" class="no-js" data-lenis={lenis ? 'on' : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/img/og.webp" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`}></style>
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      // Runs before the first paint so a saved theme never flashes the other one.
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <Chrome />
    <main>
      <slot />
    </main>
    {footer && <Footer />}
    <div class="cursor" aria-hidden="true"><Arrow /></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
